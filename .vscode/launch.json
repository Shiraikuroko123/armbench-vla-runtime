{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ArmBench: VLA tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_vla.py",
        "tests/test_vla_online.py",
        "-q",
        "-s"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: VLA quick benchmark",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-guard-run",
        "--quick",
        "--run-id",
        "${input:vlaRunId}"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: OpenPI remote probe",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-probe",
        "--host",
        "${input:openpiHost}",
        "--port",
        "8000",
        "--scenario",
        "single_block",
        "--output-directory",
        "results/${input:probeRunId}"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: online state-jump fault",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-online-run",
        "--quick",
        "--run-id",
        "${input:vlaRunId}",
        "--state-jump-joint",
        "1",
        "--state-jump-rad",
        "0.08",
        "--videos"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: OpenPI local loopback",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-loopback-run",
        "--scenario",
        "single_block",
        "--horizon",
        "5",
        "--max-policy-queries",
        "3",
        "--save-observations",
        "--video",
        "--output-directory",
        "results/${input:loopbackRunId}"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: validate online artifact",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-artifact-validate",
        "${workspaceFolder}/evidence/vla_online_camera_nominal_20260804",
        "--decode-videos"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: OpenPI loopback timeout fault",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-loopback-run",
        "--scenario",
        "single_block",
        "--horizon",
        "1",
        "--max-policy-queries",
        "1",
        "--fault-mode",
        "timeout",
        "--fault-delay-ms",
        "250",
        "--inference-timeout-s",
        "0.1",
        "--save-observations",
        "--output-directory",
        "results/${input:loopbackFaultRunId}"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: MuJoCo trajectory viewer",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "mujoco-view",
        "--scenario",
        "narrow_gate",
        "--clearance-mm",
        "20"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ArmBench: OpenPI online closed loop",
      "type": "debugpy",
      "request": "launch",
      "module": "armbench",
      "args": [
        "vla-openpi-run",
        "--host",
        "${input:openpiHost}",
        "--port",
        "8000",
        "--scenario",
        "single_block",
        "--horizon",
        "1",
        "--max-policy-queries",
        "3",
        "--video",
        "--output-directory",
        "results/${input:openpiOnlineRunId}"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "vlaRunId",
      "type": "promptString",
      "description": "New result directory name",
      "default": "vscode_vla_debug_01"
    },
    {
      "id": "openpiHost",
      "type": "promptString",
      "description": "OpenPI policy server hostname or IP",
      "default": "127.0.0.1"
    },
    {
      "id": "probeRunId",
      "type": "promptString",
      "description": "New OpenPI probe directory name",
      "default": "openpi_probe_01"
    },
    {
      "id": "loopbackRunId",
      "type": "promptString",
      "description": "New local OpenPI loopback directory name",
      "default": "openpi_loopback_01"
    },
    {
      "id": "loopbackFaultRunId",
      "type": "promptString",
      "description": "New loopback fault result directory name",
      "default": "openpi_loopback_timeout_01"
    },
    {
      "id": "openpiOnlineRunId",
      "type": "promptString",
      "description": "New remote OpenPI online result directory name",
      "default": "openpi_online_01"
    }
  ]
}
