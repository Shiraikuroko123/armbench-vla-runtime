+def test_guidance_actions_follow_input_transforms_and_have_independent_audit():
+    policy, calls = _make_policy()
+    raw_actions = np.arange(6, dtype=np.float32).reshape(3, 2)
+    weights = np.array([1.0, 0.4, 0.0], dtype=np.float32)
+
+    result = policy.infer(
+        {"state": np.array([1.0, 2.0], dtype=np.float32)},
+        guidance_actions=raw_actions,
+        guidance_weights=weights,
+        guidance_schedule="exp",
+        max_guidance_weight=4.0,
+    )
+
+    model_actions = np.asarray(calls[0]["guidance_actions"])
+    np.testing.assert_array_equal(model_actions[0, :, :2], raw_actions * 2.0)
+    np.testing.assert_array_equal(model_actions[0, :, 2:], 0.0)
+    np.testing.assert_array_equal(np.asarray(calls[0]["guidance_weights"])[0], weights)
+    assert calls[0]["max_guidance_weight"] == 4.0
+    np.testing.assert_array_equal(result["actions"], raw_actions + 0.125)
+    assert "policy_conditioning" not in result
+    audit = result["policy_guidance"]
+    assert audit["method"] == "rtc_pseudoinverse_guidance"
+    assert audit["schedule"] == "exp"
+    assert audit["guidance_active"] is True
+    assert audit["guided_steps"] == 2
+    assert audit["max_weighted_model_residual"] == 0.25
+    assert len(audit["weights_sha256"]) == 64
+
+
+def test_zero_guidance_weights_preserve_legacy_sampler_call_and_emit_audit():
+    policy, calls = _make_policy()
+    actions = np.ones((3, 2), dtype=np.float32)
+
+    result = policy.infer(
+        {"state": np.array([1.0, 2.0], dtype=np.float32)},
+        guidance_actions=actions,
+        guidance_weights=np.zeros(3, dtype=np.float32),
+    )
+
+    assert calls == [{}]
+    assert result["policy_guidance"]["guidance_active"] is False
+    assert "policy_conditioning" not in result
+
+
+def test_projected_conditioning_and_rtc_guidance_are_mutually_exclusive():
+    policy, calls = _make_policy()
+    actions = np.zeros((3, 2), dtype=np.float32)
+
+    with pytest.raises(ValueError, match="mutually exclusive"):
+        policy.infer(
+            {"state": np.array([1.0, 2.0], dtype=np.float32)},
+            condition_actions=actions,
+            condition_mask=np.array([True, False, False]),
+            guidance_actions=actions,
+            guidance_weights=np.array([1.0, 0.0, 0.0], dtype=np.float32),
+        )
+
+    assert calls == []
