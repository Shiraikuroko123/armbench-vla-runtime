+        (np.zeros((3, 2)), None, {}, "provided together"),
+        (np.zeros((2, 2)), np.zeros(3), {}, "action_horizon"),
+        (np.zeros((3, 5)), np.zeros(3), {}, "raw_action_dim"),
+        (np.full((3, 2), np.nan), np.zeros(3), {}, "finite"),
+        (np.zeros((3, 2)), np.zeros(2), {}, "shape"),
+        (np.zeros((3, 2)), np.array([1.0, 0.2, 0.4]), {}, "nonincreasing"),
+        (np.zeros((3, 2)), np.array([1.0, -0.1, 0.0]), {}, "within"),
+        (np.zeros((3, 2)), np.array([1.0, np.nan, 0.0]), {}, "finite"),
+        (np.zeros((3, 2)), np.zeros(3), {"guidance_schedule": "bad"}, "schedule"),
+        (np.zeros((3, 2)), np.zeros(3), {"guidance_schedule": []}, "schedule"),
+        (np.zeros((3, 2)), np.zeros(3), {"max_guidance_weight": -1.0}, "nonnegative"),
