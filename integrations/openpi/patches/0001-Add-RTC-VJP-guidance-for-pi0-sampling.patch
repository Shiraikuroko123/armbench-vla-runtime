--- a/src/openpi/models/pi0.py
+++ b/src/openpi/models/pi0.py
@@ -21,6 +21,35 @@ def _project_flow_condition(x_t, initial_noise, condition_actions, condition_mas
     return jnp.where(condition_mask[..., None], known_t, x_t)
 
 
+def _reverse_rtc_guidance_gain(time, max_guidance_weight):
+    time = jnp.asarray(time)
+    denominator = time * (1.0 - time)
+    safe_denominator = jnp.maximum(denominator, jnp.finfo(time.dtype).tiny)
+    numerator = time**2 + (1.0 - time) ** 2
+    return jnp.minimum(numerator / safe_denominator, max_guidance_weight)
+
+
+def _rtc_guided_velocity(
+    velocity_fn,
+    x_t,
+    time,
+    guidance_actions,
+    guidance_weights,
+    max_guidance_weight,
+):
+    """Apply official RTC's VJP correction under OpenPI's reverse clock."""
+
+    def denoiser(candidate):
+        velocity = velocity_fn(candidate)
+        return candidate - time * velocity, velocity
+
+    predicted_actions, pullback, velocity = jax.vjp(denoiser, x_t, has_aux=True)
+    error = (guidance_actions - predicted_actions) * guidance_weights[..., None]
+    correction = pullback(error)[0]
+    gain = _reverse_rtc_guidance_gain(time, max_guidance_weight)
+    return velocity - gain * correction
+
+
