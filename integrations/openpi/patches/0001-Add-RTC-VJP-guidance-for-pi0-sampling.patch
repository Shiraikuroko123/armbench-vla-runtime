@@ -2,6 +2,8 @@ import jax.numpy as jnp
 import numpy as np
 
 from openpi.models.pi0 import _project_flow_condition
+from openpi.models.pi0 import _reverse_rtc_guidance_gain
+from openpi.models.pi0 import _rtc_guided_velocity
 
 
 def test_projected_flow_path_endpoints_are_exact():
@@ -16,3 +18,86 @@ def test_projected_flow_path_endpoints_are_exact():
     np.testing.assert_array_equal(np.asarray(at_noise[:, :2]), np.asarray(noise[:, :2]))
     np.testing.assert_array_equal(np.asarray(at_action[:, :2]), np.asarray(actions[:, :2]))
     np.testing.assert_array_equal(np.asarray(at_action[:, 2:]), np.asarray(state[:, 2:]))
+
+
+def test_reverse_rtc_guidance_gain_is_finite_at_openpi_first_step():
+    times = jnp.array([0.0, 1e-8, 0.5, 1.0 - 1e-8, 1.0], dtype=jnp.float32)
+    gains = _reverse_rtc_guidance_gain(times, 5.0)
+
+    assert np.all(np.isfinite(np.asarray(gains)))
+    np.testing.assert_array_equal(np.asarray(gains)[[0, 1, 3, 4]], 5.0)
+    assert float(gains[2]) == 2.0
+
+
+def test_rtc_vjp_matches_linear_denoiser_adjoint_and_reverse_sign():
+    matrix = jnp.array(
+        [
+            [0.20, -0.10, 0.00, 0.05],
+            [0.30, 0.10, -0.20, 0.00],
+            [0.00, 0.15, -0.10, 0.20],
+            [-0.05, 0.00, 0.10, 0.25],
+        ],
+        dtype=jnp.float32,
+    )
+    state = jnp.array([[[0.2, -0.4], [0.6, 0.8]]], dtype=jnp.float32)
+    reference = jnp.array([[[-0.3, 0.1], [0.2, -0.5]]], dtype=jnp.float32)
+    weights = jnp.array([[1.0, 0.25]], dtype=jnp.float32)
+    time = jnp.array(0.7, dtype=jnp.float32)
+
+    def velocity(candidate):
+        flat = candidate.reshape(1, -1)
+        return (flat @ matrix.T).reshape(candidate.shape)
+
+    actual = _rtc_guided_velocity(
+        velocity,
+        state,
+        time,
+        reference,
+        weights,
+        5.0,
+    )
+    raw_velocity = velocity(state)
+    predicted = state - time * raw_velocity
+    error = ((reference - predicted) * weights[..., None]).reshape(-1)
+    jacobian = jnp.eye(4, dtype=jnp.float32) - time * matrix
+    correction = (jacobian.T @ error).reshape(state.shape)
+    expected = raw_velocity - _reverse_rtc_guidance_gain(time, 5.0) * correction
+
+    np.testing.assert_allclose(np.asarray(actual), np.asarray(expected), rtol=1e-6, atol=1e-6)
+
+
+def test_rtc_reverse_sign_moves_euler_step_toward_reference():
+    state = jnp.zeros((1, 2, 2), dtype=jnp.float32)
+    reference = jnp.ones_like(state)
+    weights = jnp.array([[1.0, 0.5]], dtype=jnp.float32)
+
+    guided_velocity = _rtc_guided_velocity(
+        jnp.zeros_like,
+        state,
+        jnp.array(1.0, dtype=jnp.float32),
+        reference,
+        weights,
+        5.0,
+    )
+    next_state = state - 0.1 * guided_velocity
+
+    assert np.linalg.norm(np.asarray(reference - next_state)) < np.linalg.norm(np.asarray(reference - state))
+
+
+def test_rtc_zero_weights_return_exact_raw_velocity():
+    state = jnp.arange(8, dtype=jnp.float32).reshape(1, 2, 4) / 7.0
+
+    def velocity(candidate):
+        return 0.3 * candidate - 0.2
+
+    raw_velocity = velocity(state)
+    guided_velocity = _rtc_guided_velocity(
+        velocity,
+        state,
+        jnp.array(0.6, dtype=jnp.float32),
+        jnp.full_like(state, 4.0),
+        jnp.zeros((1, 2), dtype=jnp.float32),
+        5.0,
+    )
+
+    np.testing.assert_array_equal(np.asarray(guided_velocity), np.asarray(raw_velocity))
