+def _validate_guidance(
+    guidance_actions: np.ndarray | None,
+    guidance_weights: np.ndarray | None,
+    *,
+    action_horizon: int,
+    model_action_dim: int,
+    guidance_schedule: str,
+    max_guidance_weight: float,
+) -> tuple[np.ndarray, np.ndarray, str, float] | None:
+    requested = guidance_actions is not None or guidance_weights is not None
+    if not requested:
+        return None
+    if guidance_actions is None or guidance_weights is None:
+        raise ValueError("guidance_actions and guidance_weights must be provided together")
+    try:
+        actions = np.asarray(guidance_actions, dtype=np.float32, order="C")
+        weights = np.asarray(guidance_weights, dtype=np.float32, order="C")
+        maximum = float(max_guidance_weight)
+    except (TypeError, ValueError) as exc:
+        raise ValueError("RTC guidance inputs must be numeric") from exc
+    if actions.ndim != 2 or actions.shape[0] != action_horizon:
+        raise ValueError("guidance_actions must have shape (action_horizon, raw_action_dim)")
+    if actions.shape[1] <= 0 or actions.shape[1] > model_action_dim:
+        raise ValueError("guidance_actions raw_action_dim is invalid")
+    if not np.all(np.isfinite(actions)):
+        raise ValueError("guidance_actions must contain only finite values")
+    if weights.shape != (action_horizon,):
+        raise ValueError("guidance_weights must have shape (action_horizon,)")
+    if not np.all(np.isfinite(weights)):
+        raise ValueError("guidance_weights must contain only finite values")
+    if np.any(weights < 0.0) or np.any(weights > 1.0):
+        raise ValueError("guidance_weights must lie within [0, 1]")
+    if np.any(np.diff(weights) > 0.0):
+        raise ValueError("guidance_weights must be nonincreasing")
+    if not isinstance(guidance_schedule, str) or guidance_schedule not in GUIDANCE_SCHEDULES:
+        raise ValueError("unsupported guidance_schedule")
+    if not np.isfinite(maximum) or maximum < 0.0:
+        raise ValueError("max_guidance_weight must be finite and nonnegative")
+    return (
+        np.array(actions, copy=True, order="C"),
+        np.array(weights, copy=True, order="C"),
+        guidance_schedule,
+        maximum,
+    )
+
+
