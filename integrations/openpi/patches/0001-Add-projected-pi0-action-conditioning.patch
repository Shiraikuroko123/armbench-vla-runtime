+        if conditioning is not None and self._is_pytorch_model:
+            raise ValueError("projected flow conditioning is only supported by the JAX pi0 sampler")
+        if conditioning is not None and "actions" in obs:
+            raise ValueError("observation actions are reserved when conditioning is requested")
+
         # Make a copy since transformations may modify the inputs in place.
         inputs = jax.tree.map(lambda x: x, obs)
+        if conditioning is not None:
+            inputs["actions"] = conditioning[0]
         inputs = self._input_transform(inputs)
+        model_condition_actions = None
+        if conditioning is not None:
+            if "actions" not in inputs:
+                raise ValueError("input transforms dropped condition_actions")
+            model_condition_actions = np.asarray(inputs.pop("actions"), dtype=np.float32, order="C")
+            expected_shape = (self._model.action_horizon, self._model.action_dim)
+            if model_condition_actions.shape != expected_shape:
+                raise ValueError("transformed condition_actions do not match the model action shape")
+            if not np.all(np.isfinite(model_condition_actions)):
+                raise ValueError("transformed condition_actions must contain only finite values")
+            raw_action_dim = conditioning[0].shape[1]
+            if raw_action_dim < self._model.action_dim and np.any(model_condition_actions[:, raw_action_dim:] != 0):
+                raise ValueError("transformed condition_actions must use zero-valued padded dimensions")
         if not self._is_pytorch_model:
             # Make a batch and convert to jax.Array.
             inputs = jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], inputs)
@@ -86,6 +160,9 @@ class Policy(BasePolicy):
             if noise.ndim == 2:  # If noise is (action_horizon, action_dim), add batch dimension
                 noise = noise[None, ...]  # Make it (1, action_horizon, action_dim)
             sample_kwargs["noise"] = noise
+        if conditioning is not None:
+            sample_kwargs["condition_actions"] = jnp.asarray(model_condition_actions)[None, ...]
+            sample_kwargs["condition_mask"] = jnp.asarray(conditioning[1])[None, ...]
 
         observation = _model.Observation.from_dict(inputs)
         start_time = time.monotonic()
@@ -99,10 +176,29 @@ class Policy(BasePolicy):
         else:
             outputs = jax.tree.map(lambda x: np.asarray(x[0, ...]), outputs)
 
+        conditioning_audit = None
+        if conditioning is not None:
+            selected = conditioning[1]
+            residual = (
+                float(np.max(np.abs(outputs["actions"][selected] - model_condition_actions[selected])))
