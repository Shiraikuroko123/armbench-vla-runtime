         prefix_attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
@@ -238,6 +256,8 @@ class Pi0(_model.BaseModel):
 
         def step(carry):
             x_t, time = carry
+            if conditioning_enabled:
+                x_t = _project_flow_condition(x_t, noise, condition_actions, condition_mask, time)
             suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
                 observation, x_t, jnp.broadcast_to(time, batch_size)
             )
@@ -268,7 +288,11 @@ class Pi0(_model.BaseModel):
             assert prefix_out is None
             v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
 
-            return x_t + dt * v_t, time + dt
+            next_x = x_t + dt * v_t
+            next_time = time + dt
+            if conditioning_enabled:
+                next_x = _project_flow_condition(next_x, noise, condition_actions, condition_mask, next_time)
+            return next_x, next_time
 
         def cond(carry):
             x_t, time = carry
