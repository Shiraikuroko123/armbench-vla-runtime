diff --git a/src/openpi/models/pi0_conditioning_test.py b/src/openpi/models/pi0_conditioning_test.py
new file mode 100644
index 0000000..06283aa
--- /dev/null
+++ b/src/openpi/models/pi0_conditioning_test.py
@@ -0,0 +1,18 @@
+import jax.numpy as jnp
+import numpy as np
+
+from openpi.models.pi0 import _project_flow_condition
+
+
+def test_projected_flow_path_endpoints_are_exact():
+    noise = jnp.arange(24, dtype=jnp.float32).reshape(1, 3, 8)
+    actions = -noise
+    mask = jnp.array([[True, True, False]])
+    state = jnp.full_like(noise, 99.0)
+
+    at_noise = _project_flow_condition(state, noise, actions, mask, 1.0)
+    at_action = _project_flow_condition(state, noise, actions, mask, 0.0)
+
+    np.testing.assert_array_equal(np.asarray(at_noise[:, :2]), np.asarray(noise[:, :2]))
+    np.testing.assert_array_equal(np.asarray(at_action[:, :2]), np.asarray(actions[:, :2]))
+    np.testing.assert_array_equal(np.asarray(at_action[:, 2:]), np.asarray(state[:, 2:]))
diff --git a/src/openpi/policies/conditioning_test.py b/src/openpi/policies/conditioning_test.py
new file mode 100644
index 0000000..5d72743
--- /dev/null
+++ b/src/openpi/policies/conditioning_test.py
@@ -0,0 +1,105 @@
+# ruff: noqa: SLF001
+
+from types import SimpleNamespace
+
+import jax
+import numpy as np
+import pytest
+
+from openpi.policies import policy as _policy
+
+
+def _make_policy():
+    policy = object.__new__(_policy.Policy)
+    policy._model = SimpleNamespace(action_horizon=3, action_dim=4)
+    policy._sample_kwargs = {}
+    policy._metadata = {}
+    policy._is_pytorch_model = False
+    policy._pytorch_device = "cpu"
+    policy._rng = jax.random.key(0)
+    calls = []
+
+    def input_transform(data):
+        output = {
+            "state": np.pad(np.asarray(data["state"], dtype=np.float32), (0, 2)),
+            "image": {
+                "base_0_rgb": np.zeros((2, 2, 3), dtype=np.uint8),
+                "left_wrist_0_rgb": np.zeros((2, 2, 3), dtype=np.uint8),
+                "right_wrist_0_rgb": np.zeros((2, 2, 3), dtype=np.uint8),
+            },
+            "image_mask": {
+                "base_0_rgb": np.True_,
+                "left_wrist_0_rgb": np.True_,
+                "right_wrist_0_rgb": np.False_,
+            },
+        }
+        if "actions" in data:
+            normalized = np.asarray(data["actions"], dtype=np.float32) * 2.0
+            output["actions"] = np.pad(normalized, ((0, 0), (0, 2)))
+        return output
+
+    def sample_actions(_rng, _observation, **kwargs):
+        calls.append(kwargs)
+        if "condition_actions" in kwargs:
+            return kwargs["condition_actions"]
+        return np.zeros((1, 3, 4), dtype=np.float32)
+
+    policy._input_transform = input_transform
+    policy._output_transform = lambda data: {"actions": np.asarray(data["actions"])[..., :2] / 2.0}
+    policy._sample_actions = sample_actions
+    return policy, calls
+
+
+def test_condition_actions_follow_input_transforms_and_are_audited():
+    policy, calls = _make_policy()
+    raw_actions = np.arange(6, dtype=np.float32).reshape(3, 2)
+    mask = np.array([True, True, False])
+
+    result = policy.infer(
+        {"state": np.array([1.0, 2.0], dtype=np.float32)},
+        condition_actions=raw_actions,
+        condition_mask=mask,
+    )
+
+    model_actions = np.asarray(calls[0]["condition_actions"])
+    np.testing.assert_array_equal(model_actions[0, :, :2], raw_actions * 2.0)
+    np.testing.assert_array_equal(model_actions[0, :, 2:], 0.0)
+    np.testing.assert_array_equal(np.asarray(calls[0]["condition_mask"])[0], mask)
+    np.testing.assert_array_equal(result["actions"], raw_actions)
+    assert result["policy_conditioning"]["method"] == "projected_flow_inpainting"
+    assert result["policy_conditioning"]["conditioned_prefix_steps"] == 2
+    assert result["policy_conditioning"]["max_model_residual"] == 0.0
+    assert len(result["policy_conditioning"]["model_actions_sha256"]) == 64
+
+
+def test_no_condition_preserves_the_legacy_sampler_call():
+    policy, calls = _make_policy()
+
+    result = policy.infer({"state": np.array([1.0, 2.0], dtype=np.float32)})
+
+    assert calls == [{}]
+    assert "policy_conditioning" not in result
+
+
+@pytest.mark.parametrize(
+    ("actions", "mask", "message"),
+    [
+        (np.zeros((3, 2)), None, "provided together"),
+        (np.zeros((2, 2)), np.zeros(3, dtype=bool), "action_horizon"),
+        (np.zeros((3, 5)), np.zeros(3, dtype=bool), "raw_action_dim"),
+        (np.full((3, 2), np.nan), np.zeros(3, dtype=bool), "finite"),
+        (np.zeros((3, 2)), np.zeros(3, dtype=np.int8), "boolean"),
+        (np.zeros((3, 2)), np.array([True, False, True]), "contiguous prefix"),
+    ],
+)
+def test_malformed_conditioning_fails_before_sampling(actions, mask, message):
+    policy, calls = _make_policy()
+
+    with pytest.raises(ValueError, match=message):
+        policy.infer(
+            {"state": np.array([1.0, 2.0], dtype=np.float32)},
+            condition_actions=actions,
+            condition_mask=mask,
+        )
+
+    assert calls == []
