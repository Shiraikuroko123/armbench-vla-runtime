index b9b708b..e3fe332 100644
--- a/src/openpi/policies/policy.py
+++ b/src/openpi/policies/policy.py
@@ -1,4 +1,5 @@
 from collections.abc import Sequence
+import hashlib
 import logging
 import pathlib
 import time
@@ -20,6 +21,46 @@ from openpi.shared import nnx_utils
 
 BasePolicy: TypeAlias = _base_policy.BasePolicy
 
+CONDITIONING_SCHEMA_VERSION = "armbench.openpi_conditioning.v1"
+CONDITIONING_METHOD = "projected_flow_inpainting"
+
+
+def _array_sha256(value: np.ndarray, dtype: str) -> str:
+    canonical = np.asarray(value, dtype=np.dtype(dtype), order="C")
+    return hashlib.sha256(canonical.tobytes(order="C")).hexdigest()
+
+
+def _validate_conditioning(
+    condition_actions: np.ndarray | None,
+    condition_mask: np.ndarray | None,
+    *,
+    action_horizon: int,
+    model_action_dim: int,
+) -> tuple[np.ndarray, np.ndarray] | None:
+    requested = condition_actions is not None or condition_mask is not None
+    if not requested:
+        return None
+    if condition_actions is None or condition_mask is None:
+        raise ValueError("condition_actions and condition_mask must be provided together")
+
+    try:
+        actions = np.asarray(condition_actions, dtype=np.float32, order="C")
+    except (TypeError, ValueError) as exc:
+        raise ValueError("condition_actions must be a numeric array") from exc
+    mask = np.asarray(condition_mask)
+    if actions.ndim != 2 or actions.shape[0] != action_horizon:
+        raise ValueError("condition_actions must have shape (action_horizon, raw_action_dim)")
+    if actions.shape[1] <= 0 or actions.shape[1] > model_action_dim:
+        raise ValueError("condition_actions raw_action_dim is invalid")
+    if not np.all(np.isfinite(actions)):
+        raise ValueError("condition_actions must contain only finite values")
+    if mask.dtype != np.bool_ or mask.shape != (action_horizon,):
+        raise ValueError("condition_mask must be boolean with shape (action_horizon,)")
+    false_seen = np.maximum.accumulate(~mask)
+    if np.any(mask & false_seen):
+        raise ValueError("condition_mask must select a contiguous prefix")
+    return np.array(actions, copy=True, order="C"), np.array(mask, copy=True, order="C")
+
 
 class Policy(BasePolicy):
     def __init__(
@@ -65,10 +106,43 @@ class Policy(BasePolicy):
             self._rng = rng or jax.random.key(0)
 
     @override
-    def infer(self, obs: dict, *, noise: np.ndarray | None = None) -> dict:  # type: ignore[misc]
+    def infer(
+        self,
+        obs: dict,
+        *,
+        noise: np.ndarray | None = None,
+        condition_actions: np.ndarray | None = None,
+        condition_mask: np.ndarray | None = None,
