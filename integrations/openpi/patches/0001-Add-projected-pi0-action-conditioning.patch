+                "raw_actions_sha256": _array_sha256(conditioning[0], "<f4"),
+                "model_actions_sha256": _array_sha256(model_condition_actions, "<f4"),
+                "mask_sha256": _array_sha256(selected, "u1"),
+                "max_model_residual": residual,
+            }
         outputs = self._output_transform(outputs)
         outputs["policy_timing"] = {
             "infer_ms": model_time * 1000,
         }
+        if conditioning_audit is not None:
+            outputs["policy_conditioning"] = conditioning_audit
         return outputs
 
