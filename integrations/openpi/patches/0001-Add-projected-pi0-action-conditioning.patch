 logger = logging.getLogger("openpi")
 
 
+def _project_flow_condition(x_t, initial_noise, condition_actions, condition_mask, time):
+    known_t = time * initial_noise + (1.0 - time) * condition_actions
+    return jnp.where(condition_mask[..., None], known_t, x_t)
+
+
